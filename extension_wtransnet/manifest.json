{
  "manifest_version": 3,
  "name": "Buscador Wtransnet (sólo lectura)",
  "version": "1.5.1",
  "description": "Busca cargas y camiones en tu sesión de Wtransnet, los relaciona y genera un Excel. No publica, no contacta, no contrata.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://app.wtransnet.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Buscador Wtransnet",
    "default_icon": {
      "16": "iconos/16.png",
      "48": "iconos/48.png",
      "128": "iconos/128.png"
    }
  },
  "icons": {
    "16": "iconos/16.png",
    "48": "iconos/48.png",
    "128": "iconos/128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}