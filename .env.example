# =====================================================================
#  AG Cloud · configuración (copia este archivo como «.env» en el servidor)
#  NUNCA subas el .env a GitHub ni lo compartas: contiene las claves.
# =====================================================================

APP_NAME="AG Cloud"
# production en Hostinger · local en tu ordenador
APP_ENV=production
# Se genera con: php artisan key:generate   (¡guárdala fuera del servidor!)
APP_KEY=
# SIEMPRE false en producción (si no, se verían datos internos en los errores)
APP_DEBUG=false
APP_URL=https://app.gestoriaagopyme.es
APP_TIMEZONE=Europe/Madrid
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_MAINTENANCE_DRIVER=file

# Clave de cifrado de los documentos. La genera «php artisan agcloud:instalar».
# SIN ELLA LOS DOCUMENTOS NO SE PUEDEN RECUPERAR: cópiala en tu gestor de contraseñas.
DOCS_KEY=

# Contraseña con la que se cifran las copias de seguridad (mínimo 12 caracteres).
# Inventa una larga y guárdala también en tu gestor de contraseñas.
BACKUP_ARCHIVE_PASSWORD=
# Días que se guardan las copias en el servidor y en Google Drive
BACKUP_DIAS_LOCAL=7
BACKUP_DIAS_DRIVE=30

# Copias en Google Drive (opcional pero recomendado; ver guía)
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=

# Datos del despacho
DESPACHO_NOMBRE="GA AGOPYME SL"
DESPACHO_NIF=
DESPACHO_EMAIL=info@gestoriaagopyme.es
DESPACHO_TELEFONO=
DESPACHO_PROVINCIA=Huelva

# Tamaño máximo por archivo subido (KB) y cupo orientativo por cliente (MB)
AGCLOUD_MAX_UPLOAD_KB=20480
AGCLOUD_CUPO_MB=5120

# Solo si activas la CDN de Hostinger delante de la web: TRUSTED_PROXIES=*
TRUSTED_PROXIES=

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# Base de datos MySQL creada en hPanel › Bases de datos
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Sesiones: cifradas, solo por HTTPS, caducan a las 2 h de inactividad
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Correo (buzón info@ de Hostinger) — hPanel › Correos › Configuración
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@gestoriaagopyme.es
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@gestoriaagopyme.es
MAIL_FROM_NAME="GA AGOPYME"

BCRYPT_ROUNDS=12
